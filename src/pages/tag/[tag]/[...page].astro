---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { siteConfig } from "@/site.config";
import ArticlesNavigator from "@/components/ArticlesNavigator.astro";
import ArticleTile from "@/components/ArticleTile.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExpressiveBadge from "@/components/expressive/ExpressiveBadge.astro";
import { snake_case } from "@/utils/snakecase";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");

  const tags = new Set<string>();

  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).flatMap((tag) => {
    const tagPosts = posts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(tagPosts, {
      params: {
        tag: snake_case(tag),
      },
      props: {
        tag,
      },
      pageSize: siteConfig.blog.pageSize,
    });
  });
};

type Props = {
  tag: string;
  page: Page<CollectionEntry<"blog">>;
};

const { tag, page } = Astro.props;
---

<BaseLayout title={`#${tag}`} showTitleTemplate>
  <main class="mx-auto max-w-4xl px-4 py-10 md:px-6">
    <div class="mb-6">
      <a
        href="/tag"
        class="m3-pill mb-4 inline-flex items-center gap-1.5 border border-border bg-card/80 px-3.5 py-1 font-mono text-xs text-muted-foreground no-underline hover:border-primary/45 hover:bg-primary-container hover:text-on-primary-container"
      >
        ← All tags
      </a>
      <h1 class="page-title flex flex-wrap items-center gap-3">
        <ExpressiveBadge class="text-[0.86em]">
          <span class="mr-0.5 text-primary">#</span>{tag}
        </ExpressiveBadge>
        <span class="font-mono text-sm font-normal tabular-nums text-muted-foreground">
          {page.total} {page.total === 1 ? "post" : "posts"}
        </span>
      </h1>
    </div>
    <div class="space-y-4">
      {
        page.data.map((post, index) => (
          <ArticleTile post={post} eagerLoading={index < 5} />
        ))
      }
    </div>

    <ArticlesNavigator page={page} basePath={`/tag/${snake_case(tag)}`} />
  </main>
</BaseLayout>
