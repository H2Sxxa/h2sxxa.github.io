---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { PAGE_SIZE } from "@/consts";
import ArticlesNavigator from "@/components/ArticlesNavigator.astro";
import ArticleTile from "@/components/ArticleTile.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { snake_case } from "@/utils/snakecase";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");

  const tags = new Set<string>();

  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).flatMap((tag) => {
    const tagPosts = posts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(tagPosts, {
      params: {
        tag: snake_case(tag),
      },
      props: {
        tag,
      },
      pageSize: PAGE_SIZE,
    });
  });
};

type Props = {
  tag: string;
  page: Page<CollectionEntry<"blog">>;
};

const { tag, page } = Astro.props;
---

<BaseLayout title={`#${tag}`} showTitleTemplate>
  <main class="mx-auto max-w-4xl px-4 py-10 md:px-6">
    <h1 class="mb-2 font-serif text-3xl font-bold tracking-tight">
      <span class="mr-1 text-primary">#</span>{tag}
    </h1>
    <p class="mb-6 text-sm text-muted-foreground md:text-base">
      <a href="/tag" class="hover:underline">← View all tags</a>
    </p>
    <div class="space-y-4">
      {
        page.data.map((post, index) => (
          <ArticleTile post={post} eagerLoading={index < 5} />
        ))
      }
    </div>

    <ArticlesNavigator prev={page.url.prev} next={page.url.next} />
  </main>
</BaseLayout>
