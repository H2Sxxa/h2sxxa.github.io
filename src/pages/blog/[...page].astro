---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_SIZE } from "@/consts";
import ArticlesNavigator from "@/components/ArticlesNavigator.astro";
import ArticleTile from "@/components/ArticleTile.astro";

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, {
    pageSize: PAGE_SIZE,
  });
};

const { page } = Astro.props;
---

<BaseLayout title="Blog" showTitleTemplate>
  <main class="mx-auto max-w-4xl px-4 py-10 md:px-6">
    <header class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h1 class="font-serif text-3xl font-bold tracking-tight md:text-4xl">
          Blog
        </h1>
        <p class="mt-1.5 text-sm text-muted-foreground md:text-base">
          RSS is available at{" "}
          <a href="/rss.xml" class="font-mono text-primary hover:underline"
            >rss.xml</a
          >
          <span class="mx-2 text-border">|</span>
          <a href="/tag" class="text-primary hover:underline">Browse by tags</a>
        </p>
      </div>

      <button
        type="button"
        data-open-cmd
        class="m3-pill inline-flex w-fit cursor-pointer items-center gap-2 border border-border bg-card/80 px-4 py-2 font-mono text-xs text-muted-foreground hover:border-primary/40 hover:bg-accent hover:text-foreground"
      >
        <Icon name="mdi:magnify" class="h-4 w-4" />
        <span>Quick search</span>
        <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 text-[10px]">
          ⌘K
        </kbd>
      </button>
    </header>

    <div class="space-y-4">
      {
        page.data.map((post, index) => (
          <ArticleTile post={post} eagerLoading={index < 5} />
        ))
      }
    </div>

    <ArticlesNavigator page={page} basePath="/blog" />
  </main>
</BaseLayout>
