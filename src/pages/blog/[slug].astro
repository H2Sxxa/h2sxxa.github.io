---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/Text.astro";
import TagChip from "@/components/TagChip.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { clip_markdown } from "@/utils/clip";
import { estimateReadingMinutes } from "@/utils/readingTime";
import { siteConfig } from "@/site.config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const sortedTags: string[] = post.data.tags
  ? [...post.data.tags].sort((a, b) => a.localeCompare(b))
  : [];
const readingMinutes: number = estimateReadingMinutes(post.body);
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 4);
const giscusConfigJson: string | null = siteConfig.comments
  ? JSON.stringify(siteConfig.comments)
  : null;
---

<BaseLayout
  image={post.data.heroImage}
  title={post.data.title}
  description={post.body ? clip_markdown(post.body, 100) : post.data.title}
  showTitleTemplate
>
  <main class="pb-12">
    <!-- Hero Image -->
    {
      post.data.heroImage && (
        <div class="mx-auto max-w-4xl px-4 pt-6 md:px-6">
          <div
            transition:name={`post-hero-${post.id}`}
            class="max-h-104 w-full overflow-hidden rounded-3xl border border-border/80 bg-card shadow-sm"
          >
            <Image
              src={post.data.heroImage}
              alt={post.data.title}
              class="h-full max-h-104 w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      )
    }

    <!-- Article Header -->
    <header class="mx-auto max-w-3xl px-4 pt-8 pb-6 text-center md:px-6">
      <div class="mb-4 flex items-center justify-center">
        <a
          href="/blog"
          class="m3-pill inline-flex items-center gap-1.5 border border-border bg-card/80 px-3.5 py-1 font-mono text-xs text-muted-foreground hover:border-primary/45 hover:bg-primary-container hover:text-on-primary-container"
        >
          <Icon name="mdi:arrow-left" class="h-3.5 w-3.5" />
          <span>Back to Blog</span>
        </a>
      </div>

      <h1
        transition:name={`post-title-${post.id}`}
        class="font-expressive-serif text-3xl leading-tight font-semibold tracking-tight text-foreground lg:text-4xl"
      >
        {post.data.title}
      </h1>

      <div
        class="mt-3 flex flex-wrap items-center justify-center gap-2 font-mono text-xs tabular-nums text-muted-foreground"
      >
        <span>
          Published on <FormattedDate date={post.data.pubDate} />
        </span>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
      </div>

      {
        post.data.wip && (
          <div
            class="mx-auto mt-5 rounded-2xl border border-tertiary/40 border-l-4 border-l-tertiary bg-tertiary-container/75 p-4 text-left text-sm text-on-tertiary-container"
            role="alert"
          >
            <p class="font-semibold">Work in Progress</p>
            <p class="mt-0.5 opacity-90">
              This article is still under development and may be incomplete.
            </p>
          </div>
        )
      }
    </header>

    <!-- Main Grid: Centered Reading Column + Sticky Sliding-Rail TOC -->
    <div
      class:list={[
        "mx-auto mt-2 px-4 md:px-6",
        tocHeadings.length > 0
          ? "max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:items-start lg:gap-10"
          : "max-w-3xl",
      ]}
    >
      <!-- Mobile Collapsible TOC -->
      {
        tocHeadings.length > 0 && (
          <details class="mb-6 rounded-2xl border border-border bg-card/80 p-4 lg:hidden">
            <summary class="cursor-pointer font-serif text-sm font-semibold text-foreground">
              Contents ({tocHeadings.length})
            </summary>
            <ul class="mt-3 space-y-1.5 border-l border-border pl-3 text-sm">
              {tocHeadings.map((heading) => (
                <li
                  class:list={[
                    heading.depth === 2 && "pl-2",
                    heading.depth === 3 && "pl-4",
                    heading.depth === 4 && "pl-6",
                  ]}
                >
                  <a
                    href={`#${heading.slug}`}
                    class="block py-0.5 text-muted-foreground hover:text-primary"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <!-- Article Content -->
      <div class="mx-auto w-full max-w-3xl min-w-0 lg:col-start-1 lg:row-start-1">
        <Text class="max-w-none">
          <Content />
        </Text>

        <!-- Tags -->
        {
          sortedTags.length > 0 && (
            <div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
              {sortedTags.map((tag) => (
                <TagChip tag={tag} class="px-3.5 py-1" />
              ))}
            </div>
          )
        }

        <!-- Giscus Comments -->
        {
          giscusConfigJson && (
            <div
              id="giscus-comments"
              class="mt-10"
              data-giscus-config={giscusConfigJson}
            />
          )
        }
      </div>

      <!-- Desktop Sticky TOC with Sliding Active Rail -->
      {
        tocHeadings.length > 0 && (
          <aside
            class="hidden lg:sticky lg:top-10 lg:col-start-2 lg:row-start-1 lg:block"
            aria-label="Table of contents"
          >
            <h2 class="mb-3 font-mono text-xs font-semibold tracking-wider text-muted-foreground">
              ON THIS PAGE
            </h2>
            <div class="relative border-l border-border/80">
              <div
                id="toc-active-rail"
                class="pointer-events-none absolute -left-px top-0 h-5 w-0.5 rounded-full bg-primary opacity-0 transition-[transform,height,opacity] duration-300 ease-(--ease-spring-soft)"
                aria-hidden="true"
              />
              <ul id="desktop-toc-list" class="space-y-1 text-sm">
                {tocHeadings.map((heading) => (
                  <li
                    class:list={[
                      heading.depth <= 2 && "pl-3.5",
                      heading.depth === 3 && "pl-6",
                      heading.depth === 4 && "pl-8",
                    ]}
                  >
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link={heading.slug}
                      class="block py-1 leading-snug text-muted-foreground transition-colors hover:text-foreground"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </main>

  <!-- Lightweight Image Lightbox -->
  <div
    id="article-lightbox"
    class="pointer-events-none fixed inset-0 z-100 hidden cursor-zoom-out items-center justify-center bg-background/85 p-4 opacity-0 backdrop-blur-md transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
  >
    <img
      id="article-lightbox-img"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[92vw] scale-95 rounded-xl border border-border object-contain shadow-2xl transition-transform duration-200"
    />
  </div>
</BaseLayout>

<script>
  import { initArticleReader } from "@/scripts/articleReader";
  initArticleReader();
</script>
