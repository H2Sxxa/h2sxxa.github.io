---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/Text.astro";
import TagChip from "@/components/TagChip.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { clip_markdown } from "@/utils/clip";
import { estimateReadingMinutes } from "@/utils/readingTime";
import { withBase } from "@/utils/url";
import { siteConfig } from "@/site.config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const sortedTags: string[] = post.data.tags
  ? [...post.data.tags].sort((a, b) => a.localeCompare(b))
  : [];
const readingMinutes: number = estimateReadingMinutes(post.body);
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 4);
const giscusConfigJson: string | null = siteConfig.comments
  ? JSON.stringify(siteConfig.comments)
  : null;
---

<BaseLayout
  image={post.data.heroImage}
  title={post.data.title}
  description={post.body ? clip_markdown(post.body, 100) : post.data.title}
  showTitleTemplate
>
  <main class="pb-12">
    <!-- Hero Image -->
    {
      post.data.heroImage && (
        <div class="mx-auto max-w-4xl px-4 pt-6 md:px-6">
          <div
            transition:name={`post-hero-${post.id}`}
            class="max-h-104 w-full overflow-hidden rounded-3xl border border-border/80 bg-card shadow-sm"
          >
            <Image
              src={post.data.heroImage}
              alt={post.data.title}
              class="h-full max-h-104 w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      )
    }

    <!-- Article Header -->
    <header class="mx-auto max-w-3xl px-4 pt-8 pb-6 text-center md:px-6">
      <div class="mb-4 flex items-center justify-center">
        <a
          href={withBase("/blog")}
          class="m3-pill inline-flex items-center gap-1.5 border border-border bg-card/80 px-3.5 py-1 font-mono text-xs text-muted-foreground hover:border-primary/45 hover:bg-primary-container hover:text-on-primary-container"
        >
          <Icon name="mdi:arrow-left" class="h-3.5 w-3.5" />
          <span>Back to Blog</span>
        </a>
      </div>

      <h1
        transition:name={`post-title-${post.id}`}
        class="font-expressive-serif text-3xl leading-tight font-semibold tracking-tight text-foreground lg:text-4xl"
      >
        {post.data.title}
      </h1>

      <div
        class="mt-3 flex flex-wrap items-center justify-center gap-2 font-mono text-xs tabular-nums text-muted-foreground"
      >
        <span>
          Published on <FormattedDate date={post.data.pubDate} />
        </span>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
      </div>

      {
        post.data.wip && (
          <div
            class="mx-auto mt-5 rounded-2xl border border-tertiary/40 border-l-4 border-l-tertiary bg-tertiary-container/75 p-4 text-left text-sm text-on-tertiary-container"
            role="alert"
          >
            <p class="font-semibold">Work in Progress</p>
            <p class="mt-0.5 opacity-90">
              This article is still under development and may be incomplete.
            </p>
          </div>
        )
      }
    </header>

    <!-- Main Grid: Centered Reading Column + Sticky Sliding-Rail TOC -->
    <div
      class:list={[
        "mx-auto mt-2 px-4 md:px-6",
        tocHeadings.length > 0
          ? "max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:items-start lg:gap-10"
          : "max-w-3xl",
      ]}
    >
      <!-- Mobile Collapsible TOC -->
      {
        tocHeadings.length > 0 && (
          <nav
            id="mobile-toc"
            data-open="false"
            aria-label="Table of contents"
            class="group/toc mx-auto mb-8 w-full max-w-3xl border-y border-border/75 lg:hidden"
          >
            <button
              id="mobile-toc-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-toc-panel"
              class="group/toc-trigger flex w-full cursor-pointer items-center justify-between gap-3 py-3 text-left transition-colors"
            >
              <span class="flex items-center gap-2.5">
                <Icon
                  name="mdi:format-list-bulleted"
                  class="h-4 w-4 shrink-0 text-primary/80 transition-colors group-hover/toc-trigger:text-primary"
                />
                <span class="font-mono text-xs font-semibold tracking-wider text-muted-foreground transition-colors group-hover/toc-trigger:text-foreground">
                  ON THIS PAGE
                </span>
                <span class="rounded-full bg-muted/70 px-2 py-0.5 font-mono text-[11px] font-medium tabular-nums text-muted-foreground">
                  {tocHeadings.length}
                </span>
              </span>
              <span
                class="mobile-toc-chevron inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-muted-foreground group-hover/toc-trigger:bg-primary-container/70 group-hover/toc-trigger:text-on-primary-container group-active/toc-trigger:scale-95"
                aria-hidden="true"
              >
                <Icon name="mdi:chevron-down" class="h-4 w-4" />
              </span>
            </button>

            <div
              id="mobile-toc-panel"
              aria-hidden="true"
              inert
              class="mobile-toc-panel"
            >
              <div class="min-h-0 overflow-hidden">
                <div class="max-h-72 overflow-y-auto pt-1 pb-4">
                  <div class="relative ml-1.5">
                    <div
                      class="mobile-toc-rail pointer-events-none absolute top-0 bottom-0 left-0 w-px bg-border/80"
                      aria-hidden="true"
                    />
                    <ul class="space-y-0.5 text-sm">
                      {tocHeadings.map((heading, index) => (
                        <li
                          class="mobile-toc-item"
                          style={`--toc-idx: ${Math.min(index, 8)}`}
                        >
                          <a
                            href={`#${heading.slug}`}
                            class:list={[
                              "relative flex min-h-10 items-center py-1.5 pr-2 leading-snug transition-colors before:pointer-events-none before:absolute before:top-2 before:bottom-2 before:-left-[0.5px] before:w-0.5 before:rounded-full before:bg-primary before:opacity-0 before:transition-opacity hover:text-primary hover:before:opacity-100",
                              heading.depth <= 2 &&
                                "pl-3.5 font-medium text-foreground/85",
                              heading.depth === 3 && "pl-6 text-muted-foreground",
                              heading.depth >= 4 &&
                                "pl-8 text-[13px] text-muted-foreground/90",
                            ]}
                          >
                            {heading.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </nav>
        )
      }

      <!-- Article Content -->
      <div class="mx-auto w-full max-w-3xl min-w-0 lg:col-start-1 lg:row-start-1">
        <Text class="max-w-none">
          <Content />
        </Text>

        <!-- Tags -->
        {
          sortedTags.length > 0 && (
            <div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
              {sortedTags.map((tag) => (
                <TagChip tag={tag} class="px-3.5 py-1" />
              ))}
            </div>
          )
        }

        <!-- Giscus Comments -->
        {
          giscusConfigJson && (
            <div
              id="giscus-comments"
              class="mt-10"
              data-giscus-config={giscusConfigJson}
            />
          )
        }
      </div>

      <!-- Desktop Sticky TOC with Sliding Active Rail -->
      {
        tocHeadings.length > 0 && (
          <aside
            class="hidden lg:sticky lg:top-10 lg:col-start-2 lg:row-start-1 lg:block"
            aria-label="Table of contents"
          >
            <h2 class="mb-3 font-mono text-xs font-semibold tracking-wider text-muted-foreground">
              ON THIS PAGE
            </h2>
            <div class="relative border-l border-border/80">
              <div
                id="toc-active-rail"
                class="pointer-events-none absolute -left-px top-0 h-5 w-0.5 rounded-full bg-primary opacity-0 transition-[transform,height,opacity] duration-300 ease-(--ease-spring-soft)"
                aria-hidden="true"
              />
              <ul id="desktop-toc-list" class="space-y-1 text-sm">
                {tocHeadings.map((heading) => (
                  <li
                    class:list={[
                      heading.depth <= 2 && "pl-3.5",
                      heading.depth === 3 && "pl-6",
                      heading.depth === 4 && "pl-8",
                    ]}
                  >
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link={heading.slug}
                      class="block py-1 leading-snug text-muted-foreground transition-colors hover:text-foreground"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </main>

  <!-- Lightweight Image Lightbox -->
  <div
    id="article-lightbox"
    class="pointer-events-none fixed inset-0 z-100 hidden cursor-zoom-out items-center justify-center bg-background/85 p-4 opacity-0 backdrop-blur-md transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
  >
    <img
      id="article-lightbox-img"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[92vw] scale-95 rounded-xl border border-border object-contain shadow-2xl transition-transform duration-200"
    />
  </div>
</BaseLayout>

<style>
  .mobile-toc-chevron {
    transition:
      transform 320ms var(--ease-spring-soft),
      background-color 180ms ease,
      color 180ms ease;
  }

  #mobile-toc[data-open="true"] .mobile-toc-chevron {
    transform: rotate(180deg);
    background-color: color-mix(
      in oklab,
      var(--primary-container) 70%,
      transparent
    );
    color: var(--on-primary-container);
  }

  /* Critically damped curves: smooth height fold with zero overshoot or close clamping */
  .mobile-toc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  #mobile-toc[data-open="true"] .mobile-toc-panel {
    grid-template-rows: 1fr;
    transition: grid-template-rows 340ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-toc-rail {
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition:
      opacity 140ms ease,
      transform 180ms cubic-bezier(0.4, 0, 1, 1);
  }

  #mobile-toc[data-open="true"] .mobile-toc-rail {
    opacity: 1;
    transform: scaleY(1);
    transition:
      opacity 200ms ease 20ms,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1) 20ms;
  }

  .mobile-toc-item {
    opacity: 0;
    transform: translateY(-5px);
    transition:
      opacity 130ms ease,
      transform 150ms cubic-bezier(0.4, 0, 1, 1);
  }

  #mobile-toc[data-open="true"] .mobile-toc-item {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms ease calc(35ms + var(--toc-idx, 0) * 18ms),
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1)
        calc(25ms + var(--toc-idx, 0) * 18ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-toc-chevron,
    .mobile-toc-panel,
    .mobile-toc-rail,
    .mobile-toc-item {
      transition: none !important;
    }

    .mobile-toc-rail,
    .mobile-toc-item {
      transform: none !important;
    }
  }
</style>

<script>
  import { initArticleReader } from "@/scripts/articleReader";
  initArticleReader();
</script>
