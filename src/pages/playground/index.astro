---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DecorativeCard from "@/components/DecorativeCard.astro";
import DecorativeIndex from "@/components/DecorativeIndex.astro";
import DecorativeTitle from "@/components/DecorativeTitle.astro";
import ExpressiveItalic from "@/components/expressive/ExpressiveItalic.astro";
import ExpressiveBadge from "@/components/expressive/ExpressiveBadge.astro";
---

<BaseLayout title="Playground" showTitleTemplate>
  <main class="page">
    <h1 class="page-title" aria-label="Playground">
      <ExpressiveItalic>Play</ExpressiveItalic><ExpressiveBadge class="ml-1">Ground</ExpressiveBadge>
    </h1>
    <p class="page-subtitle mb-8">
      Want Something, Coding Something.
    </p>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            title: "Lenis",
            href: "/playground/lenis",
            description: "A smooth scroll library for the modern web.",
          },
          {
            title: "React Three Fiber",
            href: "/playground/r3f",
            description: "A React renderer for Three.js.",
          },
          {
            title: "Wordle(WIP)",
            href: "/playground/wordle",
            description: "A word guessing game.",
          },
        ].map((link, index) => (
          <DecorativeCard>
            <DecorativeIndex>
              {index < 9 ? `0${index + 1}` : index + 1}
            </DecorativeIndex>

            <DecorativeTitle
              href={link.href}
              title={link.title}
              description={link.description}
            />
          </DecorativeCard>
        ))
      }
    </div>
  </main>
</BaseLayout>
