---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BackgroundGrid from "@/components/BackgroundGrid.astro";
import { EXPLORE_LINKS } from "@/consts.ts";
import { Icon } from "astro-icon/components";
---

<BaseLayout>
  <BackgroundGrid />
  <main class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-7xl">
      <h1 class="font-serif text-3xl font-bold">Explore</h1>
      <p class="mb-6 text-lg text-muted-foreground">
        I don't like to use a navigation bar, so I put all the links here.
      </p>

      <div class="grid gap-4 md:grid-cols-3">
        {
          EXPLORE_LINKS.map((link, index) => (
            <article class="group decorative">
              <div class="decorative-index">
                {index < 11 ? `0${index + 1}` : index + 1}
              </div>

              <h2 class="block font-serif text-2xl font-semibold text-primary no-underline transition-colors hover:text-primary/80 hover:underline">
                <a href={link.href}>{link.title}</a>
              </h2>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">
                {link.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
