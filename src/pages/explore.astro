---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BackgroundGrid from "@/components/BackgroundGrid.astro";
import { EXPLORE_LINKS, SITE_OWNER_LINKS } from "@/consts.ts";

import Divider from "@/components/Divider.astro";
import FlatGrid from "@/components/FlatGrid.astro";
import DecorativeCard from "@/components/DecorativeCard.astro";
import DecorativeIndex from "@/components/DecorativeIndex.astro";
import DecorativeTitle from "@/components/DecorativeTitle.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout>
  <BackgroundGrid />
  <main class="page">
    <h1 class="font-serif text-3xl font-bold">Explore</h1>
    <p class="mb-6 text-lg text-muted-foreground">
      I don't like to use a navigation bar, so I put all the links here.
    </p>

    <FlatGrid>
      {
        EXPLORE_LINKS.map((link, index) => (
          <DecorativeCard>
            <DecorativeIndex>
              {index < 11 ? `0${index + 1}` : index + 1}
            </DecorativeIndex>

            <DecorativeTitle
              href={link.href}
              title={link.title}
              description={link.description}
            />
          </DecorativeCard>
        ))
      }
    </FlatGrid>
    <Divider />
    <FlatGrid>
      {
        SITE_OWNER_LINKS.map((link) => (
          <DecorativeCard>
            <DecorativeIndex>
              <Icon name={link.icon} />
            </DecorativeIndex>

            <DecorativeTitle
              href={link.href}
              title={link.title}
              description={link.description}
            />
          </DecorativeCard>
        ))
      }
    </FlatGrid>
  </main>
</BaseLayout>
