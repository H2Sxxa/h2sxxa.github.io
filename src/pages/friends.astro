---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FRIENDS_LINKS } from "@/consts";
import { Image } from "astro:assets";
---

<BaseLayout title="Friends" showTitleTemplate>
  <main class="page">
    <h1 class="font-serif text-3xl font-bold tracking-tight md:text-4xl">
      Friends
    </h1>
    <p class="mt-1.5 mb-8 text-sm text-muted-foreground md:text-base">
      Feel free to add your own blog link!
    </p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        FRIENDS_LINKS.map((friend, index) => (
          <a
            href={friend.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group decorative flex items-center gap-4 p-4"
          >
            <Image
              src={friend.avatar}
              alt={friend.title}
              inferSize
              loading="eager"
              class="h-14 w-14 shrink-0 rounded-full border-2 border-primary/30 transition-transform duration-200 group-hover:scale-105"
              aria-label={`${friend.title}'s avatar`}
            />
            <div class="min-w-0">
              <h2 class="truncate font-serif text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
                {friend.title}
              </h2>
              <p class="mt-0.5 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                {friend.intro}
              </p>
            </div>

            <div class="decorative-index text-5xl">
              {index < 9 ? `0${index + 1}` : index + 1}
            </div>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
