---
import { Icon } from "astro-icon/components";

interface Props {
  prev?: string;
  next?: string;
}

const { prev, next } = Astro.props as Props;
---

<div class="mt-8 flex items-center">
  {
    prev && (
      <a
        href={prev}
        class="m3-pill inline-flex items-center gap-2 border border-border bg-card px-4 py-2 text-sm font-medium text-foreground hover:-translate-y-0.5 hover:border-primary/40 hover:bg-accent"
      >
        <Icon name="mdi:chevron-left" class="h-4 w-4" />
        <span>Previous</span>
      </a>
    )
  }

  {
    next && (
      <a
        href={next}
        class="m3-pill ml-auto inline-flex items-center gap-2 border border-border bg-card px-4 py-2 text-sm font-medium text-foreground hover:-translate-y-0.5 hover:border-primary/40 hover:bg-accent"
      >
        <span>Next</span>
        <Icon name="mdi:chevron-right" class="h-4 w-4" />
      </a>
    )
  }
</div>
