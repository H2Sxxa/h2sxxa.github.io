---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { clip_markdown } from "@/utils/clip";
import { estimateReadingMinutes } from "@/utils/readingTime";
import { withBase } from "@/utils/url";
import FormattedDate from "./FormattedDate.astro";
import TagChip from "./TagChip.astro";

interface Props {
  post: CollectionEntry<"blog">;
  eagerLoading: boolean;
}

const { post, eagerLoading } = Astro.props as Props;

const excerpt: string = post.body ? clip_markdown(post.body, 110) : "";
const readingMinutes: number = estimateReadingMinutes(post.body);
const tags: readonly string[] = post.data.tags ?? [];
const primaryTag: string | undefined = tags[0];
const overflowTags: readonly string[] = tags.slice(1);
---

<article
  class="group relative block overflow-hidden rounded-3xl elevated bg-card p-6 transition-[transform,border-color,box-shadow] duration-300 ease-(--ease-spring-soft) hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md active:scale-[0.99]"
>
  {/* Hero Image (Desktop only, readable in both light & dark modes) */}
  {
    post.data.heroImage && (
      <div
        transition:name={`post-hero-${post.id}`}
        class="pointer-events-none absolute top-0 right-0 hidden h-full w-64 overflow-hidden rounded-r-3xl md:block"
        aria-hidden="true"
      >
        <Image
          src={post.data.heroImage}
          alt=""
          loading={eagerLoading ? "eager" : "lazy"}
          class="h-full w-full mask-[linear-gradient(to_left,black_20%,transparent_95%)] object-cover opacity-35 transition-transform duration-300 group-hover:scale-105 dark:opacity-25"
        />
      </div>
    )
  }

  {/* Content */}
  <div class="relative z-10 flex flex-col md:max-w-[78%]">
    <div
      class="flex items-center gap-2 font-mono text-xs tabular-nums text-muted-foreground"
    >
      <FormattedDate date={post.data.pubDate} />
      <span aria-hidden="true">·</span>
      <span>{readingMinutes} min read</span>
      {
        post.data.wip && (
          <span class="rounded-full border border-tertiary/40 bg-tertiary-container px-2 py-0.5 text-[11px] font-medium text-on-tertiary-container">
            WIP
          </span>
        )
      }
    </div>

    <h2
      transition:name={`post-title-${post.id}`}
      class="mt-2 font-serif text-xl font-semibold tracking-tight text-foreground transition-colors group-hover:text-primary lg:text-2xl"
    >
      <a
        href={withBase(`/blog/${post.id}`)}
        class="text-inherit no-underline after:absolute after:inset-0 hover:text-primary"
      >
        {post.data.title}
      </a>
    </h2>

    {
      excerpt && (
        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
          {excerpt}
        </p>
      )
    }

    {/* Tags (Primary Tag +N for consistent card rhythm) */}
    {
      primaryTag && (
        <div class="relative z-20 mt-3.5 flex items-center gap-1.5">
          <TagChip
            tag={primaryTag}
            class="border-transparent bg-muted/65 hover:border-primary/40"
          />
          {overflowTags.length > 0 && (
            <span
              title={overflowTags.map((tag: string) => `#${tag}`).join("  ")}
              class="rounded-full bg-muted/50 px-2 py-0.5 font-mono text-[11px] tabular-nums text-muted-foreground"
            >
              +{overflowTags.length}
            </span>
          )}
        </div>
      )
    }
  </div>
</article>
