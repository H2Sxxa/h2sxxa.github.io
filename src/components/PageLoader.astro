<div
  id="top-progress-bar"
  class="pointer-events-none fixed top-0 left-0 z-100 h-0.5 w-0 bg-primary opacity-0 transition-[width,opacity] duration-200 ease-out"
  aria-hidden="true"
  transition:persist="top-loader"
>
</div>

<script is:inline>
  (() => {
    if (window.__topLoaderInitialized) return;
    window.__topLoaderInitialized = true;

    let timer = 0;

    const getBar = () => document.getElementById("top-progress-bar");

    const start = () => {
      const bar = getBar();
      if (!bar) return;
      clearTimeout(timer);
      bar.style.transition = "none";
      bar.style.width = "0%";
      bar.style.opacity = "1";
      requestAnimationFrame(() => {
        bar.style.transition = "width 380ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease";
        bar.style.width = "78%";
      });
    };

    const done = () => {
      const bar = getBar();
      if (!bar) return;
      bar.style.width = "100%";
      timer = window.setTimeout(() => {
        bar.style.opacity = "0";
        window.setTimeout(() => {
          bar.style.width = "0%";
        }, 200);
      }, 140);
    };

    document.addEventListener("astro:before-preparation", start);
    document.addEventListener("astro:page-load", done);
  })();
</script>
