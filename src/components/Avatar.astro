---
import { Image } from "astro:assets";
import { cn } from "@/utils/cn";

interface Props {
  src: string;
  alt?: string | null;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { src, alt, size = "md" } = Astro.props;

const sizes = {
  sm: "h-20 w-20 md:h-24 md:w-24",
  md: "h-28 w-28 md:h-36 md:w-36",
  lg: "h-40 w-40 md:h-48 md:w-48",
};
---

<div
  class={cn(
    "inline-flex shrink-0 rounded-[40%] border-[1.5px] border-primary/35 bg-primary-container/35 p-1.5 shadow-xs transition-[border-radius,border-color,background-color] duration-400 ease-(--ease-spring) hover:rounded-[50%] hover:border-primary hover:bg-primary-container/60",
    Astro.props.class,
  )}
>
  <Image
    src={src}
    alt={alt ?? "Avatar"}
    inferSize
    loading="eager"
    class:list={["rounded-[inherit] object-cover", sizes[size]]}
  />
</div>
