---
import { Icon } from "astro-icon/components";

interface Props {
  href?: string;
  label: string;
  icon: string;
  index?: number;
}

const { href, label, icon, index = 0 } = Astro.props;
---

<a
  href={href}
  data-fab-item
  data-fab-href={href}
  style={`transition-delay: ${index * 30}ms`}
  class="fab-stagger-item group/item relative flex items-center justify-end gap-2.5"
  aria-label={label}
>
  <span
    class="pointer-events-none rounded-full border border-border bg-card/95 px-3 py-1 text-xs font-medium whitespace-nowrap text-foreground shadow-sm backdrop-blur-sm transition-[opacity,transform] duration-200 md:translate-x-1.5 md:opacity-0 md:group-hover/item:translate-x-0 md:group-hover/item:opacity-100"
  >
    {label}
  </span>
  <span
    data-fab-circle
    class="m3-pill flex h-12 w-12 items-center justify-center border border-border bg-card/95 text-foreground shadow-sm backdrop-blur-sm group-hover/item:scale-105 group-hover/item:border-primary/50 group-hover/item:bg-accent"
  >
    <Icon name={icon} class="h-5 w-5" />
  </span>
</a>
