---
import { Icon } from "astro-icon/components";
import FloatActionButtonItem from "./FloatActionButtonItem.astro";
import { FAB_LINKS } from "@/consts";
---

<div id="fab-root" class="fixed right-5 bottom-5 z-50" transition:persist="fab-root">
  <div
    id="fab-menu"
    class="pointer-events-none absolute right-0 bottom-18 flex flex-col items-end gap-2.5 opacity-0"
    aria-hidden="true"
  >
    <!-- Back to Top (visible only after scrolling) -->
    <button
      id="fab-top"
      type="button"
      style="transition-delay: 180ms"
      class="fab-stagger-item fab-action-btn m3-pill group/item relative hidden h-12 w-12 cursor-pointer items-center justify-center border border-border bg-card/95 text-foreground shadow-sm backdrop-blur-sm hover:scale-105 hover:border-primary/50 hover:bg-accent"
      aria-label="Back to top"
    >
      <span
        class="pointer-events-none absolute right-[calc(100%+10px)] rounded-full border border-border bg-card/95 px-3 py-1 text-xs font-medium whitespace-nowrap text-foreground shadow-sm backdrop-blur-sm transition-[opacity,transform] duration-200 md:translate-x-1.5 md:opacity-0 md:group-hover/item:translate-x-0 md:group-hover/item:opacity-100"
      >
        Top
      </span>
      <Icon name="mdi:arrow-up" class="h-5 w-5" />
    </button>

    <!-- Command Palette trigger -->
    <button
      id="fab-search"
      type="button"
      style="transition-delay: 150ms"
      class="fab-stagger-item fab-action-btn m3-pill group/item relative flex h-12 w-12 cursor-pointer items-center justify-center border border-border bg-card/95 text-foreground shadow-sm backdrop-blur-sm hover:scale-105 hover:border-primary/50 hover:bg-accent"
      aria-label="Search (Ctrl+K)"
    >
      <span
        class="pointer-events-none absolute right-[calc(100%+10px)] rounded-full border border-border bg-card/95 px-3 py-1 font-mono text-xs font-medium whitespace-nowrap text-foreground shadow-sm backdrop-blur-sm transition-[opacity,transform] duration-200 md:translate-x-1.5 md:opacity-0 md:group-hover/item:translate-x-0 md:group-hover/item:opacity-100"
      >
        Search ⌘K
      </span>
      <Icon name="mdi:magnify" class="h-5 w-5" />
    </button>

    <!-- Theme Toggle -->
    <button
      id="fab-theme"
      type="button"
      style="transition-delay: 120ms"
      class="fab-stagger-item fab-action-btn m3-pill group/item relative flex h-12 w-12 cursor-pointer items-center justify-center border border-border bg-card/95 text-foreground shadow-sm backdrop-blur-sm hover:scale-105 hover:border-primary/50 hover:bg-accent"
      aria-label="Toggle color theme"
    >
      <span
        class="pointer-events-none absolute right-[calc(100%+10px)] rounded-full border border-border bg-card/95 px-3 py-1 text-xs font-medium whitespace-nowrap text-foreground shadow-sm backdrop-blur-sm transition-[opacity,transform] duration-200 md:translate-x-1.5 md:opacity-0 md:group-hover/item:translate-x-0 md:group-hover/item:opacity-100"
      >
        Theme
      </span>
      <Icon name="mdi:weather-sunny" class="hidden h-5 w-5 dark:block" />
      <Icon name="mdi:weather-night" class="block h-5 w-5 dark:hidden" />
    </button>

    <div class="my-0.5 h-px w-8 self-center bg-border/80"></div>

    {
      FAB_LINKS.map((link, index) => (
        <FloatActionButtonItem
          href={link.href}
          label={link.label}
          icon={link.icon}
          index={FAB_LINKS.length - 1 - index}
        />
      ))
    }
  </div>

  <!-- Main M3 Expressive FAB (Morphs squircle <-> circle on open/press) -->
  <button
    id="fab-toggle"
    type="button"
    aria-expanded="false"
    aria-label="Open navigation menu"
    class="fab-main relative flex h-14 w-14 cursor-pointer items-center justify-center rounded-[20px] bg-primary text-primary-foreground shadow-lg hover:shadow-xl active:scale-92"
  >
    <!-- Progress Ring SVG -->
    <svg
      class="pointer-events-none absolute -inset-1.5 h-17 w-17 -rotate-90"
      viewBox="0 0 68 68"
      aria-hidden="true"
    >
      <rect
        id="fab-ring-track"
        x="2"
        y="2"
        width="64"
        height="64"
        rx="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="text-border/45 transition-[rx] duration-300"
      />
      <rect
        id="fab-progress-ring"
        x="2"
        y="2"
        width="64"
        height="64"
        rx="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-dasharray="238"
        stroke-dashoffset="238"
        class="text-primary transition-[stroke-dashoffset,rx] duration-150"
      />
    </svg>

    <span id="fab-icon-wrap" class="pointer-events-none flex items-center justify-center">
      <span id="fab-icon-menu">
        <Icon name="mdi:menu" class="h-6 w-6" />
      </span>
      <span id="fab-icon-close" class="hidden">
        <Icon name="mdi:close" class="h-6 w-6" />
      </span>
    </span>
  </button>
</div>

<style>
  .fab-main {
    transition:
      border-radius 360ms var(--ease-spring),
      transform 320ms var(--ease-spring),
      box-shadow 220ms ease,
      background-color 200ms ease;
  }

  .fab-main[aria-expanded="true"] {
    border-radius: 9999px;
  }

  #fab-icon-wrap {
    transition: transform 380ms var(--ease-spring);
  }

  .fab-main[aria-expanded="true"] #fab-icon-wrap {
    transform: rotate(90deg);
  }

  #fab-menu {
    transition: opacity 180ms ease;
  }

  :global(.fab-stagger-item) {
    opacity: 0;
    transform: translateY(12px) scale(0.82);
    transition:
      opacity 220ms ease,
      transform 340ms var(--ease-spring),
      border-radius 320ms var(--ease-spring),
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  #fab-menu[data-open="true"] :global(.fab-stagger-item) {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Clear stagger delay once menu is open so hover responds immediately */
  #fab-menu[data-open="true"] :global(.fab-stagger-item:hover) {
    transition-delay: 0ms !important;
    transform: translateY(0) scale(1.06);
  }

  #fab-menu[data-open="true"] :global(.fab-stagger-item:active) {
    transition-delay: 0ms !important;
    transform: translateY(0) scale(0.95);
  }

  :global([data-fab-item][data-active="true"]) {
    border-color: var(--primary);
    background-color: var(--accent);
    color: var(--primary);
    border-radius: 1rem;
  }
</style>

<script is:inline>
  (() => {
    const RING_PERIMETER = 238;

    const getEls = () => ({
      root: document.getElementById("fab-root"),
      toggle: document.getElementById("fab-toggle"),
      menu: document.getElementById("fab-menu"),
      iconMenu: document.getElementById("fab-icon-menu"),
      iconClose: document.getElementById("fab-icon-close"),
      ring: document.getElementById("fab-progress-ring"),
      ringTrack: document.getElementById("fab-ring-track"),
      topBtn: document.getElementById("fab-top"),
    });

    const isOpen = () => {
      const { toggle } = getEls();
      return toggle?.getAttribute("aria-expanded") === "true";
    };

    const setOpen = (next) => {
      const { toggle, menu, iconMenu, iconClose, ring, ringTrack } = getEls();
      if (!toggle || !menu) return;
      toggle.setAttribute("aria-expanded", String(next));
      menu.setAttribute("aria-hidden", String(!next));
      menu.setAttribute("data-open", String(next));

      const rx = next ? "32" : "24";
      ring?.setAttribute("rx", rx);
      ringTrack?.setAttribute("rx", rx);

      if (next) {
        menu.classList.remove("opacity-0", "pointer-events-none");
        menu.classList.add("opacity-100", "pointer-events-auto");
        iconMenu?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
      } else {
        menu.classList.remove("opacity-100", "pointer-events-auto");
        menu.classList.add("opacity-0", "pointer-events-none");
        iconMenu?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
      }
    };

    const syncActiveRoute = () => {
      const path = window.location.pathname;
      document.querySelectorAll("[data-fab-item]").forEach((el) => {
        const href = el.getAttribute("data-fab-href");
        if (!href) return;
        const isActive =
          href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
        el.setAttribute("data-active", String(isActive));
      });
    };

    const updateScrollProgress = () => {
      const { ring, topBtn } = getEls();
      const maxScroll =
        document.documentElement.scrollHeight - window.innerHeight;
      const ratio =
        maxScroll > 40 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;

      if (ring) {
        ring.style.strokeDashoffset = String(RING_PERIMETER * (1 - ratio));
      }
      if (topBtn) {
        const showTop = window.scrollY > 320;
        topBtn.classList.toggle("hidden", !showTop);
        topBtn.classList.toggle("flex", showTop);
      }
    };

    const bindMagnetic = () => {
      if (
        window.matchMedia("(pointer: coarse)").matches ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        return;
      }
      const { toggle } = getEls();
      if (!toggle || toggle.dataset.magneticBound === "1") return;
      toggle.dataset.magneticBound = "1";

      toggle.addEventListener("pointermove", (e) => {
        const rect = toggle.getBoundingClientRect();
        const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.16;
        const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.16;
        toggle.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
      });

      toggle.addEventListener("pointerleave", () => {
        toggle.style.transform = "";
      });
    };

    if (!window.__fabDelegatedBound) {
      window.__fabDelegatedBound = true;

      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        if (target.closest("#fab-toggle")) {
          setOpen(!isOpen());
          return;
        }

        if (target.closest("#fab-theme")) {
          if (typeof window.__toggleTheme === "function") {
            window.__toggleTheme(e.clientX, e.clientY);
          }
          return;
        }

        if (target.closest("#fab-search")) {
          setOpen(false);
          if (typeof window.__openCommandPalette === "function") {
            window.__openCommandPalette();
          }
          return;
        }

        if (target.closest("#fab-top")) {
          setOpen(false);
          window.scrollTo({ top: 0, behavior: "smooth" });
          return;
        }

        const { root } = getEls();
        if (isOpen() && root && !root.contains(target)) {
          setOpen(false);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen()) {
          setOpen(false);
        }
      });

      window.addEventListener("scroll", updateScrollProgress, { passive: true });
      window.addEventListener("resize", updateScrollProgress, { passive: true });

      document.addEventListener("astro:after-swap", () => {
        setOpen(false);
        bindMagnetic();
        syncActiveRoute();
        updateScrollProgress();
      });

      document.addEventListener("astro:page-load", () => {
        bindMagnetic();
        syncActiveRoute();
        updateScrollProgress();
      });
    }

    bindMagnetic();
    syncActiveRoute();
    updateScrollProgress();
  })();
</script>
