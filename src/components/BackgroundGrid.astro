<div class="bg-grid"></div>

<script is:inline>
  const glowState =
    window.__gridGlowState ||
    (window.__gridGlowState = {
      targetX: 0,
      targetY: 0,
      currentX: 0,
      currentY: 0,
      active: false,
      initialized: false,
      grid: null,
      rafId: 0,
      lastUpdateTime: 0,
    });

  const speed = 0.05;
  const updateInterval = 16;
  const maxDelta = 12;

  function applyGlowPosition(x, y) {
    glowState.currentX = x;
    glowState.currentY = y;

    if (glowState.grid) {
      glowState.grid.style.setProperty("--mouse-x", `${glowState.currentX}px`);
      glowState.grid.style.setProperty("--mouse-y", `${glowState.currentY}px`);
    }
  }

  function animate() {
    const now = performance.now();
    if (now - glowState.lastUpdateTime < updateInterval) {
      glowState.rafId = requestAnimationFrame(animate);
      return;
    }

    glowState.lastUpdateTime = now;
    glowState.currentX += (glowState.targetX - glowState.currentX) * speed;
    glowState.currentY += (glowState.targetY - glowState.currentY) * speed;

    const dx = glowState.currentX - glowState.targetX;
    const dy = glowState.currentY - glowState.targetY;

    if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) {
      applyGlowPosition(glowState.targetX, glowState.targetY);
    } else {
      applyGlowPosition(glowState.currentX, glowState.currentY);
    }

    glowState.rafId = requestAnimationFrame(animate);
  }

  function initGridGlow() {
    const grid = document.querySelector(".bg-grid");
    if (!grid) {
      return;
    }

    glowState.grid = grid;

    if (!glowState.initialized) {
      window.addEventListener(
        "mousemove",
        (e) => {
          const nextX = e.clientX;
          const nextY = e.clientY;
          const dx = nextX - glowState.targetX;
          const dy = nextY - glowState.targetY;

          if (Math.abs(dx) < maxDelta && Math.abs(dy) < maxDelta) {
            return;
          }

          glowState.targetX = nextX;
          glowState.targetY = nextY;
          glowState.active = true;

          if (glowState.grid) {
            glowState.grid.classList.add("active");
          }
        },
        { passive: true },
      );

      animate();
      glowState.initialized = true;
    }

    if (glowState.active && grid) {
      grid.classList.add("active");
    }
  }
  if (!window.matchMedia("(pointer: coarse)").matches) {
    document.addEventListener("astro:page-load", initGridGlow);
    initGridGlow();
  }
</script>

<style>
  .bg-grid {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;

    --grid-size: 40px;
    --edge-fade: 18%;
    --safe-margin: 24px;

    background-image:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--border) 18%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--border) 18%, transparent) 1px,
        transparent 1px
      );

    background-size: var(--grid-size) var(--grid-size);
    background-position: center;
    background-repeat: repeat;

    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--border) 8%, transparent),
      inset 0 0 80px color-mix(in oklab, var(--background) 70%, transparent);
  }

  .bg-grid::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--background) 8%, transparent) 0%,
        transparent 22%,
        transparent 78%,
        color-mix(in oklab, var(--background) 8%, transparent) 100%
      ),
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--background) 8%, transparent) 0%,
        transparent 22%,
        transparent 78%,
        color-mix(in oklab, var(--background) 8%, transparent) 100%
      );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .bg-grid::after {
    content: "";
    position: absolute;
    inset: calc(var(--safe-margin) * -1);
    opacity: 0;
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--primary) 20%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--primary) 20%, transparent) 1px,
        transparent 1px
      );

    background-size: var(--grid-size) var(--grid-size);
    background-position: center;
    background-repeat: repeat;

    mask-image: radial-gradient(
      180px circle at var(--mouse-x) var(--mouse-y),
      black 0%,
      black 28%,
      transparent 82%
    );

    -webkit-mask-image: radial-gradient(
      180px circle at var(--mouse-x) var(--mouse-y),
      black 0%,
      black 28%,
      transparent 82%
    );
    filter: blur(0.5px);
  }

  .bg-grid.active::after {
    opacity: 0.85;
  }
</style>
